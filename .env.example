# FitTrack Environment Variables

# Supabase Cloud Database Configuration
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Supabase Postgres Connection String (For direct DB pooling)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Rexi AI (Google Gemini) — SERVER-ONLY, never VITE_-prefixed.
# Consumed by the /api/rexi proxy so the key is never shipped to the browser.
# Optional: without it, Rexi falls back to built-in coaching answers.
GEMINI_API_KEY=your-gemini-api-key

# Application Core Settings
JWT_SECRET=your-secure-random-secret
NODE_ENV=production
